{
  "name": "predictivex-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "PredictiveX dashboard (React 19 + TypeScript, bundled with esbuild, served by the FastAPI backend)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --test tests-dist/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  }
}
