# Copy to .env and adjust. Real environment variables take precedence over .env.
# No secrets are required to run PredictiveX.

# Path to the trained model bundle (default: models/predictivex_model.joblib)
PREDICTIVEX_MODEL_PATH=

# Comma-separated origins allowed by CORS (only needed if the dashboard is served from another origin)
PREDICTIVEX_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional risk threshold overrides (probabilities in (0, 1)); leave empty to use the
# thresholds derived during training.
PREDICTIVEX_RISK_MEDIUM=
PREDICTIVEX_RISK_HIGH=

# Maximum records per /predict/batch request
PREDICTIVEX_MAX_BATCH=1000
